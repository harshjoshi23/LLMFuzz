# Copy this file to .env.local and edit values for your environment.
# .env.local is git-ignored.
#
# The pipeline's LLM client (src/utils/gpt4ifx_client.py) and `src.cli doctor`
# read the GPT4IFX_* variables below. Any OpenAI-compatible Chat Completions
# endpoint works; the GPT4IFX_ prefix is retained for backward compatibility.

# ---- LLM endpoint (any OpenAI-compatible Chat Completions API) ----
# Examples:
#   - OpenAI hosted:   https://api.openai.com
#   - Azure OpenAI:    https://<resource>.openai.azure.com
#   - Local ollama:    http://localhost:11434/v1
#   - Internal proxy:  https://<your-llm-endpoint>
GPT4IFX_BASE_URL=https://<your-llm-endpoint>

# ---- Model selection (optional; defaults: gpt-5.2 / gpt-5.2-mini) ----
# THESIS_LLM_PRIMARY_MODEL=gpt-4o
# THESIS_LLM_FALLBACK_MODEL=gpt-4o-mini

# ---- Authentication (use ONE of the following) ----

# Option A — Bearer / API key
GPT4IFX_API_KEY=sk-...

# Option B — OAuth2 client-credentials (service account)
# GPT4IFX_CLIENT_ID=
# GPT4IFX_CLIENT_SECRET=
# GPT4IFX_TOKEN_URL=
# GPT4IFX_SCOPE=

# Option C — Legacy username / password (HTTP basic)
# LLAMA_USER=
# LLAMA_PASSWORD=

# ---- TLS (optional; only set if your endpoint uses a private CA) ----
# GPT4IFX_CA_BUNDLE=/path/to/your-ca-bundle.crt

# ---- Pipeline switches ----
THESIS_LLM_ENABLED=1
